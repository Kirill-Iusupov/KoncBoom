# Environment прод-проекта KantsBum в OMV (docker-compose.prod.yml).
# Один файл на всё: его читают и compose (db, build-arg frontend), и backend (env_file).
# OMV сохраняет его в KantsBum.env и делает рядом симлинк .env.

# --- PostgreSQL ---
POSTGRES_DB=koncboom
POSTGRES_USER=koncboom
POSTGRES_PASSWORD=change-me-strong-password   # openssl rand -hex 24
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me                   # openssl rand -base64 48
DJANGO_ALLOWED_HOSTS=kantsbum.shop,www.kantsbum.shop
DJANGO_ENABLE_TLS=True
CSRF_TRUSTED_ORIGINS=https://kantsbum.shop,https://www.kantsbum.shop
CORS_ALLOWED_ORIGINS=https://kantsbum.shop

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend (build-arg) ---
# Нужен только next.config.ts для images.remotePatterns; запросы идут на относительный /api.
NEXT_PUBLIC_API_URL=https://kantsbum.shop/api
